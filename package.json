{
  "name": "printama",
  "version": "1.0.0",
  "description": "Aplikasi Desktop Penata & Pencetak Pas Foto Presisi & Hemat Kertas",
  "main": "./out/main/index.js",
  "author": "AdyatamaTECH",
  "homepage": "https://adyatamatech.com",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
